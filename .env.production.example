# ⚠️ เทมเพลตสำหรับขึ้น production — ก๊อปเป็น .env.local (หรือตั้งค่าบน Vercel)
# ตัวที่ขึ้นต้นด้วย "เปลี่ยน_" ต้องใส่ค่าจริงทั้งหมดก่อน deploy
# อย่า commit ไฟล์ที่มีค่าจริง (ดู .gitignore: .env* ถูก ignore ยกเว้น *.example)

# ── Supabase ──────────────────────────────────────────────────────────────────
# เอามาจาก Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=เปลี่ยน_เป็น_URL_ของ_Supabase_project_เช่น_https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=เปลี่ยน_เป็น_anon_public_key
SUPABASE_SERVICE_ROLE_KEY=เปลี่ยน_เป็น_service_role_key_ห้าม_รั่วไหล

# ── LINE OA (Messaging API) ───────────────────────────────────────────────────
# จาก LINE Developers Console > Messaging API
LINE_CHANNEL_ACCESS_TOKEN=เปลี่ยน_เป็น_LINE_Channel_Access_Token
LINE_CHANNEL_SECRET=เปลี่ยน_เป็น_LINE_Channel_Secret
LINE_GROUP_ID=เปลี่ยน_เป็น_Group_ID_ของห้องแอดมิน
# LINE_RECIPIENT_IDS=user_id1,user_id2   # (ไม่บังคับ — ถ้าจะ push ถึงตัวบุคคลแทน group)

# ── Messenger (Meta) ──────────────────────────────────────────────────────────
# จาก Meta for Developers > App > App settings / Messenger
FACEBOOK_APP_SECRET=เปลี่ยน_เป็น_Facebook_App_Secret
FACEBOOK_WEBHOOK_VERIFY_TOKEN=เปลี่ยน_เป็น_verify_token_ที่ตั้งเอง_ตอนผูก_webhook
FACEBOOK_PAGE_ACCESS_TOKEN=เปลี่ยน_เป็น_Page_Access_Token_แบบ_ไม่หมดอายุ
FACEBOOK_MESSENGER_RECIPIENT_IDS=เปลี่ยน_เป็น_PSID_ของแอดมิน_ถ้ามีหลายคน_คั่นด้วย_comma
META_GRAPH_API_VERSION=v20.0

# ── เว็บไซต์ / ลิงก์ติดต่อ (ใช้ในลิงก์จองจากแชท + ปุ่มติดต่อ) ──────────────────
PUBLIC_BASE_URL=เปลี่ยน_เป็น_URL_จริง_เช่น_https://fairymatenail.vercel.app
NEXT_PUBLIC_LINE_OA_URL=เปลี่ยน_เป็น_ลิงก์_LINE_OA_เช่น_https://line.me/R/ti/p/@xxx
NEXT_PUBLIC_MESSENGER_URL=เปลี่ยน_เป็น_ลิงก์_m.me_เช่น_https://m.me/xxx

# ── Admin (Basic Auth — middleware.ts) ────────────────────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=เปลี่ยน_เป็นรหัสผ่าน_ยาว_ไม่ใช้_1234
